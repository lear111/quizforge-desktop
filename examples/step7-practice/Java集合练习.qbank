    {
      "id": "q_demo_hashset_unique",
      "type": "SINGLE_CHOICE",
      "stimulusRefs": [],
      "prompt": {
        "kind": "TEXT",
        "text": "向 HashSet 重复添加同一个元素，题目中的哪项描述正确？"
      },
      "payload": {
        "kind": "CHOICE",
        "options": [
          {
            "id": "opt_demo_03_a",
            "content": {
              "kind": "TEXT",
              "text": "会保存两个相同元素"
            }
          },
          {
            "id": "opt_demo_03_b",
            "content": {
              "kind": "TEXT",
              "text": "不会保存重复元素"
            }
          },
          {
            "id": "opt_demo_03_c",
            "content": {
              "kind": "TEXT",
              "text": "会自动转换为 ArrayList"
            }
          }
        ]
      },
      "answerSpec": {
        "kind": "CHOICE",
        "correctOptionIds": [
