          "occurrence": 1,
          "documentTitle": "Java 集合示例",
          "sectionTitle": "HashSet"
        }
      ],
      "analysis": {
        "kind": "TEXT",
        "text": "HashSet 不保存重复元素，重复添加不会得到两个相同元素。"
