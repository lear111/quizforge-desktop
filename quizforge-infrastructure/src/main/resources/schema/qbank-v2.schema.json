{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuizForge QBank v2",
  "description": "Reader schema: optional properties may be omitted or null; null is normalized to absent. The canonical writer omits absent properties and never emits null. Non-null properties must satisfy their declared types. ID uniqueness, cross references, content semantics and exact decimal weights are additionally validated by QuestionBankValidator. Empty questions represent an editor draft.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "assetId": {
      "type": "string",
      "pattern": "^qb_[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stimuli": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stimulus"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "required": [
    "schemaVersion",
    "assetId",
    "title",
    "stimuli",
    "questions",
    "resources"
  ],
  "$defs": {
    "content": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/rich"
        },
        {
          "$ref": "#/$defs/nativeDocument"
        }
      ]
    },
    "nativeDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "DOCUMENT"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^res_[A-Za-z0-9_-]+$"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resourceId",
        "text"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "TEXT"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "rich": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RICH"
        },
        "document": {
          "$ref": "#/$defs/document"
        }
      },
      "required": [
        "kind",
        "document"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "blocks"
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/blockImage"
        },
        {
          "$ref": "#/$defs/blockMath"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/bulletList"
        },
        {
          "$ref": "#/$defs/orderedList"
        },
        {
          "$ref": "#/$defs/blockQuote"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "PARAGRAPH"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "alignment": {
          "enum": [
            "LEFT",
            "CENTER",
            "RIGHT",
            null
          ]
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    "blockImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "IMAGE"
        },
        "resourceId": {
          "type": "string"
        },
        "alt": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "widthPercent": {
          "enum": [
            25,
            50,
            75,
            100,
            null
          ]
        },
        "alignment": {
          "enum": [
            "LEFT",
            "CENTER",
            "RIGHT",
            null
          ]
        }
      },
      "required": [
        "type",
        "resourceId"
      ]
    },
    "blockMath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MATH"
        },
        "tex": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "tex"
      ]
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/inlineText"
        },
        {
          "$ref": "#/$defs/inlineImage"
        },
        {
          "$ref": "#/$defs/inlineMath"
        },
        {
          "$ref": "#/$defs/lineBreak"
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    },
    "inlineText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "TEXT"
        },
        "text": {
          "type": "string"
        },
        "marks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "BOLD",
              "ITALIC",
              "UNDERLINE",
              "STRIKE"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "inlineImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "IMAGE"
        },
        "resourceId": {
          "type": "string"
        },
        "alt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "resourceId"
      ]
    },
    "inlineMath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MATH"
        },
        "tex": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "tex"
      ]
    },
    "lineBreak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LINE_BREAK"
        }
      },
      "required": [
        "type"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LINK"
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "type",
        "href",
        "children"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^opt_[A-Za-z0-9_-]+$"
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "id",
        "content"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/choicePayload"
        },
        {
          "$ref": "#/$defs/essayPayload"
        },
        {
          "$ref": "#/$defs/clozePayload"
        },
        {
          "$ref": "#/$defs/readingPayload"
        },
        {
          "$ref": "#/$defs/matchingPayload"
        },
        {
          "$ref": "#/$defs/translationPayload"
        },
        {
          "$ref": "#/$defs/extensionData"
        }
      ]
    },
    "answer": {
      "oneOf": [
        {
          "$ref": "#/$defs/choiceAnswer"
        },
        {
          "$ref": "#/$defs/essayAnswer"
        },
        {
          "$ref": "#/$defs/clozeAnswer"
        },
        {
          "$ref": "#/$defs/readingAnswer"
        },
        {
          "$ref": "#/$defs/matchingAnswer"
        },
        {
          "$ref": "#/$defs/translationAnswer"
        },
        {
          "$ref": "#/$defs/extensionData"
        }
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMaxScore": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "defaultMaxScore"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "description",
        "weight"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "evaluatorGuidance": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "criteria"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentAssetId": {
          "type": "string",
          "pattern": "^doc_[A-Za-z0-9_-]+$"
        },
        "documentContentId": {
          "type": "string",
          "pattern": "^qfd:v[12]:[0-9a-f]{64}$"
        },
        "anchorName": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "documentTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "sectionTitle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "documentAssetId",
        "documentContentId",
        "anchorName",
        "occurrence"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q_[A-Za-z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "stimulusRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prompt": {
          "$ref": "#/$defs/content"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "answerSpec": {
          "$ref": "#/$defs/answer"
        },
        "scoreSpec": {
          "$ref": "#/$defs/score"
        },
        "evaluationSpec": {
          "anyOf": [
            {
              "$ref": "#/$defs/evaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/content"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "id",
        "type",
        "stimulusRefs",
        "prompt",
        "payload",
        "answerSpec",
        "scoreSpec",
        "sourceRefs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "ESSAY"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/essayPayload"
              },
              "answerSpec": {
                "$ref": "#/$defs/essayAnswer"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "CLOZE"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/clozePayload"
                },
                "answerSpec": {
                  "$ref": "#/$defs/clozeAnswer"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "type": {
                    "const": "READING"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "$ref": "#/$defs/readingPayload"
                  },
                  "answerSpec": {
                    "$ref": "#/$defs/readingAnswer"
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "type": {
                      "const": "MATCHING"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "payload": {
                      "$ref": "#/$defs/matchingPayload"
                    },
                    "answerSpec": {
                      "$ref": "#/$defs/matchingAnswer"
                    }
                  }
                },
                "else": {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "TRANSLATION"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "payload": {
                        "$ref": "#/$defs/translationPayload"
                      },
                      "answerSpec": {
                        "$ref": "#/$defs/translationAnswer"
                      }
                    }
                  },
                  "else": {
                    "if": {
                      "properties": { "type": { "enum": ["SINGLE_CHOICE", "MULTIPLE_CHOICE"] } }
                    },
                    "then": {
                      "properties": {
                        "payload": { "$ref": "#/$defs/choicePayload" },
                        "answerSpec": { "$ref": "#/$defs/choiceAnswer" }
                      }
                    },
                    "else": {
                      "properties": {
                        "payload": { "$ref": "#/$defs/extensionData" },
                        "answerSpec": { "$ref": "#/$defs/extensionData" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "id",
        "content"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^res_[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "IMAGE",
            "AUDIO",
            "DOCUMENT"
          ]
        },
        "mediaType": {
          "type": "string",
          "pattern": "^(image|audio|application)/[A-Za-z0-9.+-]+$"
        },
        "locator": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[:\\\\\\r\\n])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "mediaType",
        "locator",
        "sha256"
      ]
    },
    "extensionData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "EXTENSION" },
        "data": { "type": "object" }
      },
      "required": ["kind", "data"]
    },
    "choicePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CHOICE"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 2
        }
      },
      "required": [
        "kind",
        "options"
      ]
    },
    "choiceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CHOICE"
        },
        "correctOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^opt_[A-Za-z0-9_-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "correctOptionIds"
      ]
    },
    "essayPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ESSAY"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "essayAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ESSAY"
        },
        "referenceAnswer": {
          "anyOf": [
            {
              "$ref": "#/$defs/content"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "HEADING"
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "alignment": {
          "enum": [
            "LEFT",
            "CENTER",
            "RIGHT",
            null
          ]
        }
      },
      "required": [
        "type",
        "level",
        "children"
      ]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "blocks"
      ]
    },
    "bulletList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "BULLET_LIST"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      },
      "required": [
        "type",
        "items"
      ]
    },
    "orderedList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ORDERED_LIST"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      },
      "required": [
        "type",
        "start",
        "items"
      ]
    },
    "blockQuote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "BLOCK_QUOTE"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type",
        "blocks"
      ]
    },
    "clozeBlank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^blank_[A-Za-z0-9_-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "id",
        "number",
        "options"
      ]
    },
    "clozePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CLOZE"
        },
        "blanks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clozeBlank"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "blanks"
      ]
    },
    "clozeAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CLOZE"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blankId": {
                "type": "string",
                "pattern": "^blank_[A-Za-z0-9_-]+$"
              },
              "correctOptionId": {
                "type": "string",
                "pattern": "^opt_[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "blankId",
              "correctOptionId"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "answers"
      ]
    },
    "readingItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item_[A-Za-z0-9_-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^opt_[A-Za-z0-9_-]+$"
              },
              "content": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "id",
              "content"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "prompt": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "id",
        "number",
        "options",
        "prompt"
      ]
    },
    "readingPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "READING"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/readingItem"
          }
        }
      },
      "required": [
        "kind",
        "items"
      ]
    },
    "readingAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "READING"
        },
        "answers": {
          "type": "array",
          "items": {
